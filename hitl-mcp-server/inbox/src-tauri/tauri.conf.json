{
  "$schema": "https://raw.githubusercontent.com/nicbarker/tauri/dev/.schema/config.schema.json",
  "productName": "HITL Inbox",
  "version": "2.11.3",
  "identifier": "com.hitl.inbox",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "inbox",
        "title": "LLM Inbox",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 500,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../client/src-tauri/icons/32x32.png",
      "../../client/src-tauri/icons/128x128.png",
      "../../client/src-tauri/icons/128x128@2x.png",
      "../../client/src-tauri/icons/icon.icns",
      "../../client/src-tauri/icons/icon.ico"
    ]
  }
}
