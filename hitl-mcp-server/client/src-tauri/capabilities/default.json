{
  "identifier": "default",
  "description": "Default capabilities for the HITL client",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "shell:default"
  ]
}
