{
  "name": "@achieveai/hitl-mcp-server",
  "version": "2.0.0",
  "description": "Human-in-the-Loop MCP Server — enables LLM agents to ask questions across all your devices via ntfy.sh",
  "type": "module",
  "main": "./dist/mcp-server.js",
  "bin": {
    "hitl": "dist/cli.js",
    "hitl-mcp-server": "dist/mcp-server.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "llm",
    "human-in-the-loop",
    "hitl",
    "dialog",
    "interactive",
    "model-context-protocol",
    "ntfy",
    "notifications"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/achieveai/HumanInTheLoop.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "node dist/mcp-server.js",
    "dev": "tsx src/index.ts",
    "test": "jest --config jest.config.js",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hitl/shared": "*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "eventsource": "^2.0.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/eventsource": "^1.1.15",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "typescript": "^5.3.0",
    "tsx": "^4.0.0",
    "rimraf": "^5.0.0",
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0",
    "ts-jest": "^29.1.0"
  }
}
