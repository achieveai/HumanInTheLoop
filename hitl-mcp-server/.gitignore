# Dependencies
node_modules/

# Build output
dist/
*.js
*.js.map
*.d.ts
!jest.config.js

# The Tauri client frontend is hand-written ES modules with no build step, so
# it is source, not output. Without this negation the tree-wide *.js above
# swallows it and `git add` on a new frontend file fails silently.
!client/src/**/*.js

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# Test coverage
coverage/
.nyc_output/

# Playwright
test-results/
playwright-report/

# Temporary files
tmp/
temp/