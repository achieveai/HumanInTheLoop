# Dependencies
node_modules/

# Build output
dist/
*.js
*.js.map
*.d.ts
!jest.config.js

# The Tauri frontends are hand-written ES modules with no build step, so they
# are source, not output. Without these negations the tree-wide *.js above
# swallows them and `git add` on a new frontend file fails silently — which is
# how an app ships with none of its JavaScript and no error anywhere.
!client/src/**/*.js
!inbox/src/**/*.js

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# Test coverage
coverage/
.nyc_output/

# Playwright
test-results/
playwright-report/

# Temporary files
tmp/
temp/